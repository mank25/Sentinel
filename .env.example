# Sentinel configuration. Copy to .env and adjust as needed.
# Every value below has a working local default -- none of them are secrets.

# --- TrueForge -------------------------------------------------------------
# Where the local TrueForge server is listening.
TRUEFORGE_BASE_URL=http://localhost:8790

# Model FQN as reported by GET /api/v1/models.
TRUEFORGE_MODEL=groq/gpt-oss-120b

# Seconds to wait for an investigation turn to finish.
TRUEFORGE_TIMEOUT=300

# --- Sentinel MCP server ---------------------------------------------------
# Bind address for the streamable-HTTP MCP transport. TrueForge v0.1.4 only
# accepts remote (HTTP) MCP servers, so stdio alone is not enough for it.
SENTINEL_MCP_HOST=127.0.0.1
SENTINEL_MCP_PORT=8791

# The URL registered with TrueForge; must be reachable from TrueForge.
SENTINEL_MCP_URL=http://127.0.0.1:8791/mcp

# Resource names created in TrueForge.
SENTINEL_MCP_SERVER_NAME=sentinel-security
SENTINEL_AGENT_NAME=sentinel-investigator

# --- Secrets ---------------------------------------------------------------
# NOTE: Sentinel never reads a model provider API key.
# The Groq API key lives in TrueForge's own model-provider settings
# (Settings -> Model Providers, or POST /api/v1/settings/model-providers).
# Never commit a real key to this repository.

# Used only by scripts/check_gemini.py, a standalone smoke test that verifies
# a Gemini API key reaches Google and returns text. Sentinel's own runtime
# never reads it. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
